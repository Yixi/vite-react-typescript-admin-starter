{
  "compilerOptions": {
    "isolatedModules": true,
    "paths": {
      "@root/*": [
        "./src/*"
      ],
    },
    "rootDir": ".",
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "lib": [
      "es2020",
      "dom",
      "dom.iterable",
    ],
    "target": "es2020",
    "jsx": "react",
    "allowJs": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "./src"
  ]
}
